      "source": [
        "# Pruebas para TKnowledgeBase según las instrucciones del laboratorio\n",
        "\n",
        "# 1. Crear una KB vacía\n",
        "kb = TKnowledgeBase()\n",
        "\n",
        "# 2. Agregar primero las proposiciones (TAtom)\n",
        "atom_llueve = TAtom(\"llueve\", \"está lloviendo\")\n",
        "atom_suelo_mojado = TAtom(\"suelo_mojado\", \"el suelo está mojado\")\n",
        "\n",
        "kb.add(atom_llueve)\n",
        "kb.add(atom_suelo_mojado)\n",
        "print(\"atomos agregados exitosamente.\")\n",
        "\n",
        "# 3. Luego agregar la regla R1\n",
        "rule_r1 = TRule(\"R1\", [atom_llueve], atom_suelo_mojado)\n",
        "kb.add(rule_r1)\n",
        "print(\"Regla R1 agregada exitosamente.\")\n",
        "\n",
        "# 4. Verificar que la regla R1 quedó registrada y se recupera correctamente\n",
        "recovered_rule = kb.obtain(\"R1\")\n",
        "print(f\"\\n¿Regla R1 registrada?: {kb.has_rule('R1')}\")\n",
        "print(f\"Regla recuperada: {recovered_rule}\")\n",
        "\n",
        "# Verificar que al buscar por su variable ('llueve') se recupera la proposición\n",
        "recovered_atom = kb.atom(\"llueve\")\n",
        "print(f\"Átomo recuperado por símbolo 'llueve': '{recovered_atom.meaning}' ({recovered_atom.symbol})\")\n",
        "\n",
