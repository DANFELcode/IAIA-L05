        "class TValue:\n",
        "    \"\"\"Los valores para una proposición atómica.\"\"\"\n",
        "\n",
        "    yes = \"YES\"\n",
        "    no = \"NO\"\n",
        "    unknown = \"UNKNOWN\""
      ]
