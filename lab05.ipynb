        "class QuerySubsystem:\n",
        "    \"\"\"Subsistema de consulta: usar el conocimiento.\"\"\"\n",
        "\n",
        "    def __init__(self, kb: TKnowledgeBase, fb: TFactBase) -> None:\n",
        "        self.kb = kb\n",
        "        self.fb = fb\n",
        "\n",
        "    def pedir_atom(self) -> TAtom | None:\n",
        "        symbol = input(\"Symbol de la proposición: \").strip()\n",
        "        atom = self.kb.atom(symbol)\n",
        "        if atom is None:\n",
        "            print(\"Esa proposición no existe en la KB.\")\n",
        "        return atom\n",
        "\n",
        "    def add_fact(self) -> None:\n",
        "        \"\"\"Pedir symbol y valor y registrar el hecho en la FB.\"\"\"\n",
        "        atom = self.pedir_atom()\n",
        "        if atom is None:\n",
        "            return\n",
        "        value = ask(atom)\n",
        "        self.fb.set(atom, value, \"user\")\n",
        "        print(\"Hecho registrado.\")\n",
        "\n",
        "    def infer(self) -> None:\n",
        "        \"\"\"Ejecutar forward y mostrar los hechos recién deducidos.\"\"\"\n",
        "        antes = dict(self.fb.facts)\n",
        "        forward(self.kb, self.fb)\n",
        "        nuevos = 0\n",
        "        for atom, fact in self.fb.facts.items():\n",
        "            if antes.get(atom) != fact:\n",
        "                print(f\"{atom.meaning} = {fact[0]}, origen {fact[1]}\")\n",
        "                nuevos += 1\n",
        "        if nuevos == 0:\n",
        "            print(\"No se dedujo nada nuevo.\")\n",
        "\n",
        "    def answer(self) -> None:\n",
        "        \"\"\"Pedir una proposición y responderla con backward.\"\"\"\n",
        "        atom = self.pedir_atom()\n",
        "        if atom is None:\n",
        "            return\n",
        "        value, self.fb = backward(self.kb, self.fb, atom)\n",
        "        print(f\"{atom.meaning} = {value}, origen {self.fb.source(atom)}\")\n",
        "\n",
        "    def how(self) -> None:\n",
        "        \"\"\"Pedir una conclusión y mostrar su explicación con explain.\"\"\"\n",
        "        atom = self.pedir_atom()\n",
        "        if atom is None:\n",
        "            return\n",
        "        print(explain(self.kb, self.fb, atom))\n",
        "\n",
        "    def show(self) -> None:\n",
        "        \"\"\"Mostrar la FB actual.\"\"\"\n",
        "        if not self.fb.facts:\n",
        "            print(\"La FB está vacía.\")\n",
        "        for atom, fact in self.fb.facts.items():\n",
        "            print(f\"{atom.symbol} = {fact[0]}, origen {fact[1]}\")\n",
        "\n",
        "    def reset(self) -> None:\n",
        "        \"\"\"Iniciar una nueva consulta (vaciar la FB sin tocar la KB).\"\"\"\n",
        "        self.fb.facts.clear()\n",
        "        print(\"FB vaciada.\")\n",
        "\n",
        "    def run(self) -> None:\n",
        "        \"\"\"Mostrar el menú y ejecutar comandos hasta que el usuario salga.\"\"\"\n",
        "        comandos = {\n",
        "            \"1\": self.add_fact,\n",
        "            \"2\": self.infer,\n",
        "            \"3\": self.answer,\n",
        "            \"4\": self.how,\n",
        "            \"5\": self.show,\n",
        "            \"6\": self.reset,\n",
        "        }\n",
        "        while True:\n",
        "            print(\"1. Agregar hecho\")\n",
        "            print(\"2. Inferir con forward\")\n",
        "            print(\"3. Responder con backward\")\n",
        "            print(\"4. Explicar el cómo\")\n",
        "            print(\"5. Mostrar FB\")\n",
        "            print(\"6. Nueva consulta\")\n",
        "            print(\"0. Salir\")\n",
        "            opcion = input(\"Opción: \").strip()\n",
        "            if opcion == \"0\":\n",
        "                break\n",
        "            if opcion in comandos:\n",
        "                comandos[opcion]()\n",
        "            else:\n",
        "                print(\"Opción inválida.\")"
      ]
    },
