        "### TRule\n",
        "\n",
        "Defina una clase `TRule`"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 30,
      "id": "c016",
      "metadata": {
        "id": "c016"
      },
      "outputs": [],
      "source": [
        "class TRule:\n",
        "    \"\"\"Una cláusula definida.\"\"\"\n",
        "\n",
        "    def __init__(self, name: str, antecedents: list[TAtom], consequent: TAtom) -> None:\n",
        "      self.name = name\n",
        "      self.antecedents = antecedents\n",
        "      self.consequent = consequent\n",
        "\n",
        "    def __str__(self) -> str:\n",
        "        \"\"\"Representación en lenguaje natural de la regla.\"\"\"\n",
        "        antecedents_str = \" y \".join(map(str, self.antecedents))\n",
        "        return f\"{self.name}: {antecedents_str}, entonces {self.consequent}\""
      ]
    },
