      "source": [
        "class DevelopmentSubsystem:\n",
        "    \"\"\"Subsistema de desarrollo: construir el conocimiento.\"\"\"\n",
        "\n",
        "    def __init__(self, kb: TKnowledgeBase) -> None:\n",
        "        self.kb = kb\n",
        "\n",
        "    def add_atom(self) -> None:\n",
        "        \"\"\"Pedir symbol y meaning y registrar la proposición en la KB.\"\"\"\n",
        "        symbol = input(\"Symbol (sin espacios, ej. tiene_pelo): \").strip()\n",
        "        meaning = input(\"Meaning (ej. el animal tiene pelo): \").strip()\n",
        "\n",
        "        if not symbol or not meaning or \" \" in symbol:\n",
        "            print(\"Symbol y meaning son obligatorios, y symbol no lleva espacios.\")\n",
        "            return\n",
        "        if self.kb.atom(symbol) is not None:\n",
        "            print(f\"Ya existe una proposición con symbol '{symbol}'.\")\n",
        "            return\n",
        "\n",
        "        self.kb.add(TAtom(symbol, meaning))\n",
        "        print(f\"Proposición '{symbol}' registrada.\")\n",
        "\n",
        "    def add_rule(self) -> None:\n",
        "        \"\"\"Pedir name, antecedents y consequent y registrar la regla.\"\"\"\n",
        "        name = input(\"Identificador de la regla (ej. R1): \").strip()\n",
        "        if not name:\n",
        "            print(\"El identificador es obligatorio.\")\n",
        "            return\n",
        "        if self.kb.has_rule(name):\n",
        "            print(f\"Ya existe una regla '{name}'.\")\n",
        "            return\n",
        "\n",
        "        raw = input(\"Antecedentes (symbols separados por coma): \")\n",
        "        symbols = [s.strip() for s in raw.split(\",\") if s.strip()]\n",
        "        if not symbols:\n",
        "            print(\"Debe haber al menos un antecedente.\")\n",
        "            return\n",
        "\n",
        "        antecedents = []\n",
        "        for s in symbols:\n",
        "            atom = self.kb.atom(s)\n",
        "            if atom is None:\n",
        "                print(f\"La proposición '{s}' no está registrada. Agrégala primero.\")\n",
        "                return\n",
        "            antecedents.append(atom)\n",
        "\n",
        "        cons_symbol = input(\"Consecuente (symbol): \").strip()\n",
        "        consequent = self.kb.atom(cons_symbol)\n",
        "        if consequent is None:\n",
        "            print(f\"La proposición '{cons_symbol}' no está registrada. Agrégala primero.\")\n",
        "            return\n",
        "\n",
        "        try:\n",
        "            self.kb.add(TRule(name, antecedents, consequent))\n",
        "            print(f\"Regla '{name}' registrada.\")\n",
        "        except ValueError as e:\n",
        "            print(f\"No se pudo registrar la regla: {e}\")\n",
        "\n",
        "    def show(self) -> None:\n",
        "        \"\"\"Mostrar las proposiciones y reglas registradas.\"\"\"\n",
        "        print(\"PROPOSICIONES\")\n",
        "        if not self.kb.atoms:\n",
        "            print(\"(ninguna)\")\n",
        "        for a in self.kb.atoms.values():\n",
        "            print(f\"- {a.symbol}: {a.meaning}\")\n",
        "\n",
        "        print(\"REGLAS\")\n",
        "        if not self.kb.rules:\n",
        "            print(\"(ninguna)\")\n",
        "        for r in self.kb.rules.values():\n",
        "            ants = \" ∧ \".join(a.meaning for a in r.antecedents)\n",
        "            print(f\"{r.name}: {ants} ⇒ {r.consequent.meaning}\")\n",
        "        print()\n",
        "\n",
        "    def reset(self) -> None:\n",
        "        \"\"\"Iniciar un nuevo conocimiento (vaciar la KB).\"\"\"\n",
        "        self.kb.atoms.clear()\n",
        "        self.kb.rules.clear()\n",
        "        print(\"KB vaciada.\")\n",
        "\n",
        "    def run(self) -> None:\n",
        "        \"\"\"Mostrar el menú y ejecutar comandos hasta que el usuario salga.\"\"\"\n",
        "        comandos = {\n",
        "            \"1\": self.add_atom,\n",
        "            \"2\": self.add_rule,\n",
        "            \"3\": self.show,\n",
        "            \"4\": self.reset,\n",
        "        }\n",
        "        while True:\n",
        "            print(\"Subsistema de desarrollo\")\n",
        "            print(\"1. Agregar proposición\")\n",
        "            print(\"2. Agregar regla\")\n",
        "            print(\"3. Mostrar KB\")\n",
        "            print(\"4. Reiniciar KB\")\n",
        "            print(\"0. Salir\")\n",
        "            opcion = input(\"Opción: \").strip()\n",
        "            if opcion == \"0\":\n",
        "                break\n",
        "            accion = comandos.get(opcion)\n",
        "            if accion:\n",
        "                accion()\n",
        "            else:\n",
        "                print(\"Opción inválida.\")"
      ]
    },
