        "#1.\n",
        "import pandas as pd\n",
        "import ydf\n",
        "\n",
        "examples = pd.read_csv(\"restaurant.csv\")\n",
        "examples = examples.drop(columns=[\"example\"])\n",
        "\n",
        "# validation_ratio=0.0: no se aparta ningún ejemplo para podar, porque la poda\n",
        "# está fuera del alcance del laboratorio y con 12 ejemplos no sobra ninguno.\n",
        "# min_examples=1: permite hojas de un solo ejemplo, si no el árbol\n",
        "# se detendría antes de separar todos los ejemplos.\n",
        "# min_vocab_frequency=1: cada valor categórico cuenta aunque aparezca una\n",
        "# sola vez, si no pasaría a ser <OOD> (desconocido).\n",
        "model = ydf.CartLearner(\n",
        "    label=\"will_wait\",\n",
        "    task=ydf.Task.CLASSIFICATION,\n",
        "    validation_ratio=0.0,\n",
        "    min_examples=1,\n",
        "    min_vocab_frequency=1,\n",
        ").train(examples)\n",
        "\n",
        "model.plot_tree()\n",
        "model.print_tree()\n",
        "print(model.evaluate(examples))"
